ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://countersign:countersign@localhost:5432/countersign

# Shared secret required on the Authorization: Bearer header for all
# /v1/approvals endpoints. Generate a real value, e.g. `openssl rand -hex 32`.
REVIEWER_TOKEN=change-me-to-a-long-random-value

# How long a needs_approval action waits in the queue before it expires
# (and is treated as blocked) if no reviewer acts on it.
APPROVAL_TTL_SECONDS=3600

# API key for the demo agent (demo/refund_agent.py), checked against the
# hash registered for "demo-refund-agent" in agents.yaml. This placeholder
# is only for local development with the demo; rotate it (see agents.yaml)
# before registering any real agent.
DEMO_AGENT_API_KEY=demo-agent-dev-key-change-me
